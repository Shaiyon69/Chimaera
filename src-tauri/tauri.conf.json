{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Chimaera",
  "version": "../package.json",
  "identifier": "io.github.shaiyon69.chimaera",
  "build": {
    "frontendDist": "../out/tauri",
    "devUrl": "http://localhost:5174/tauri.html",
    "beforeDevCommand": "yarn vite --config vite.tauri.config.ts",
    "beforeBuildCommand": "yarn vite build --config vite.tauri.config.ts"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
